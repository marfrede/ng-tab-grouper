{
  "name": "ng-tab-grouper",
  "displayName": "Tab Grouper for Angular",
  "description": "Keeps the files of an Angular component next to each other in the tab bar, sorted alphabetically.",
  "version": "0.0.5",
  "publisher": "marvinfrede",
  "license": "EUPL-1.2",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/marfrede/ng-tab-grouper"
  },
  "keywords": [
    "angular",
    "tabs",
    "component",
    "editor",
    "organize"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Tab Grouper for Angular",
      "properties": {
        "angularTabGrouper.sameFolderOnly": {
          "type": "boolean",
          "default": true,
          "description": "Only group files that live in the same folder (prevents e.g. every index.ts from being grouped)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
